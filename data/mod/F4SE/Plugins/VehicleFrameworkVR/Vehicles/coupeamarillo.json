// Coupe amarillo: the yellow 1940s fastback coupe of Axel's sheet (chrome grille and bumpers, round headlights in the fenders), with the
// framework's classic wheels at 0.36 m. Body: TRELLIS.2 multiview mesh from the sheet (seed 9, 2800 steps, its own 4096 texture); only its
// windows changed: the white glass sheets cut out by alpha test in the colour map (CoupeAmarilloPaint, BGSM alpha test 128) with a clear
// glass panel behind the frames, new headlights (chrome ring, reflector, bulb, fluted lens) and the dashboard's gauges, clock and radio as
// their own pieces. Loose pieces and TRELLIS's drums removed, arches closed with dark liners, decimated from 349k to 130k triangles with the
// high mesh's normals baked into CoupeAmarilloPaint_n. TRELLIS's own cabin (benches, steering wheel, fixed: no SteeringWheel node). The body
// sits 0.21 m higher than the wheel-less sheet so the tyres fit the arches. It drives on the Coupe 50's chassis data.
// The model (CoupeAmarillo.nif) comes in VehicleFrameworkVR_Vehicles.esp (VFVR_CoupeAmarillo); it points along +Y, its ground line is z = 0.
// Positions are in GAME UNITS in the model's own frame (x = right, y = forward, z = up). Everything else is SI: kg, m, s, N, N*m.
{
  "id": "coupeamarillo",
  "displayName": "Coupe amarillo",
  "baseForm": "VehicleFrameworkVR_Vehicles.esp|0x00080C",
  "fallbackBaseForm": "VehicleFrameworkVR_Vehicles.esp|0x000800",
  "carrierForm": "",
  "boxHull": true,
  "modelForward": "+y",
  // Collision hull: the body width, from the body's lower edge to the belt line (the roof is left out: a lower, steadier centre of mass),
  // bumper to bumper (the car is 4.9 m long, 343 units, and 2.0 m wide).
  "hull": { "min": [-70, -171, 21], "max": [70, 171, 74], "rampLength": 1.0, "rampHeight": 0.45, "sideInset": 0.12 },
  "mass": 1850,
  "driveLayout": "awd",

  // The model has no wheels of its own: the wheel nodes are at x = +-59.8 / +-60.1, y = 117.2 / -99.7, z = 25.2 (classic tyres of 25.2 units,
  // bottoms on the ground line), in the middle of the arch openings (wheelbase 3.10 m, track 1.71 m). The hubs keep the Rockboy's proportion to the wheel node height (16.5 / 36.4).
  "wheels": [
    { "name": "FL", "hub": [-59.8, 117.2, 11.4], "steer": true, "drive": true, "handbrake": false },
    { "name": "FR", "hub": [59.8, 117.2, 11.4], "steer": true, "drive": true, "handbrake": false },
    { "name": "RL", "hub": [-60.1, -99.7, 11.4], "steer": false, "drive": true, "handbrake": true },
    { "name": "RR", "hub": [60.1, -99.7, 11.4], "steer": false, "drive": true, "handbrake": true }
  ],
  // The tyres' tops sit 2-4 cm under the arches: little room above the mesh position.
  "wheelVisual": { "set": "classic", "maxAboveMesh": 0.03 },
  "autoWheels": { "insetX": 13, "wheelbaseFactor": 0.58, "clearance": 12 },

  "suspension": {
    "restLength": 0.37,
    "springRate": 27000,
    "damperBump": 3200,
    "damperRebound": 3900,
    "maxForce": 19000,
    "antiRollFront": 18000,
    "antiRollRear": 5500,
    "frictionLift": 0.72
  },

  // 0.36 m classic tyres (25.2 units).
  "tyre": {
    "radius": 0.36,
    "wheelInertia": 2.3,
    "grip": 0.96,
    "longB": 10.0,
    "longC": 1.65,
    "latB": 9.0,
    "latC": 1.45,
    "rollingResistance": 0.018,
    "minSlipSpeed": 2.5
  },

  // The Atomic Coupe's engine; final drive 4.3 x 0.36 / 0.386 so the road speed per rpm stays the same on the smaller tyres.
  "engine": {
    "torqueCurve": [[1000, 330], [2500, 450], [4500, 470], [6000, 370]],
    "idleRpm": 900,
    "maxRpm": 6200,
    "gears": [3.4, 2.0, 1.35, 1.0, 0.8],
    "reverseRatio": 3.2,
    "finalDrive": 4.01,
    "efficiency": 0.85,
    "cylinders": 8,
    "shiftUpRpm": 5600,
    "shiftDownRpm": 2200,
    "shiftTime": 0.25,
    "engineBrake": 35,
    "tractionControlSlip": 0.16,
    // Voice: a big lazy V8, more rumble and lump than the Atomic Coupe's six, no blower.
    "sound": { "gain": 1.0, "pitch": 0.9, "oddDecay": 0.8, "evenDecay": 0.62, "rumble": 0.5, "lumpiness": 0.3, "noise": 1.0, "brightness": 0.75, "whine": 0.0, "whineOrder": 12 }
  },

  "brakes": { "maxTorque": 1650, "frontBias": 0.65, "handbrakeTorque": 2300, "holdSpeed": 0.35, "absSlip": 0.12 },
  "steering": { "maxAngleDeg": 33, "reduceAtSpeed": 25, "reducedFactor": 0.22, "speedDegPerSec": 210 },
  "aero": { "dragCoefficient": 0.55, "topSpeedKmh": 145 },

  // Tailpipe, right rear under the bumper.
  "exhaust": { "points": [[30, -170, 28]] },

  // Headlights at the new round lamps in the front fenders (0.84 m up).
  "lights": {
    "form": "Fallout4.esm|0x0022B18F",
    "pitchDownDeg": 4,
    "yawDeg": 90,
    "points": [[-53, 163, 59], [53, 163, 59]]
  },

  // One wheel set: the classic wheels (sWheelSet stock or classic both give them; the 4x4 sets do not fit its arches).
  "parts": {
    "wheels": [
      { "id": "stock", "name": "Classic wheels", "patch": {} }
    ]
  },

  "seat": {
    // Driver's eyes (left seat, behind TRELLIS's steering wheel at x -0.37 m), measured in TRELLIS's cabin: 0.70 m over the front bench's
    // cushion (0.76 m with the lift), 23 cm under the roof lining, 0.4 m behind the wheel.
    "driverEye": [-26.0, -3.0, 102.0],
    "exit": [-150, 0, 7],
    // Door handles on both sides, on the doors below the belt line.
    "doorHandles": [[-72, -10, 78], [72, -10, 78]],
    "interactRadius": 0.9
  },
  // Trunk: the rear deck lid, centred, just inside the tail.
  "trunk": { "point": [0, -155, 85], "capacity": 350 },
  // Health: the Atomic Coupe's (the Rockboy's): 700 points, resistant to bullets, blasts and bumps. Smoke from the bonnet; the repair at its front edge.
  "damage": { "maxHealth": 700, "resistance": { "ballistic": 100, "explosion": 50, "melee": 50, "collision": 120 }, "collision": { "minDeltaV": 3.5 }, "smoke": { "points": [[0, 128, 85]] }, "repair": { "point": [0, 172, 62] } },
  "radiation": { "resistance": 400, "capacity": 800 }
}
